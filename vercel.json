{
  "redirects": [
    { "source": "/power-bank-20000-mah", "destination": "/power-bank-20000-mah/", "permanent": true },
    { "source": "/power-bank-para-iphone", "destination": "/power-bank-para-iphone/", "permanent": true },
    { "source": "/precios-y-envios", "destination": "/precios-y-envios/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
